# Copy to .env and fill in real values. Never commit .env.
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret
# Must be the org's My Domain URL — Client Credentials flow rejects login.salesforce.com
SF_LOGIN_URL=https://your-org.my.salesforce.com
# Storefront identity for the demo user (client-visible)
VITE_SF_ACCOUNT_ID=001xxxxxxxxxxxxxxx
VITE_SF_CONTACT_ID=003xxxxxxxxxxxxxxx
