{
  "name": "@expedite-commerce/next-gen-composable",
  "version": "0.1.0",
  "description": "Foundry-30846 — reusable address entry + validation composable (ship-to / bill-to / install)",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./salesforce": {
      "types": "./dist/salesforce/index.d.ts",
      "import": "./dist/salesforce.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.lib.json && cp src/react-ui/styles.css dist/styles.css"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
